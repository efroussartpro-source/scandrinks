{
  "name": "scandrinks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "tsc -p tsconfig.json && vite build --mode e2e --outDir dist-e2e && node e2e/app-smoke.mjs",
    "screens": "vite build --mode e2e --outDir dist-e2e && node e2e/screens.mjs",
    "tutorial:trial": "node scripts/tutorial/trial.mjs && node scripts/tutorial/check.mjs --trial"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "barcode-detector": "3.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
